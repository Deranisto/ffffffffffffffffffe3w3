# Скопируйте этот файл в `.env` (локально) или задайте те же переменные в Railway → Variables.
# Реальные секреты — только в окружении, никогда в коде и репозитории.

# Токен MAX-бота (MAX → «Чат-боты» → ⋮ → Настройки → копировать токен).
# ОБЯЗАТЕЛЕН. Используется только сервером, в браузер не отправляется.
MAX_BOT_TOKEN=

# Ключ доступа к диагностическим маршрутам (/api/check, /api/monitor/*).
# ОБЯЗАТЕЛЕН. Придумайте длинную случайную строку, введите её же в панели.
# Посторонние без ключа не смогут вызывать API от имени вашего бота.
DIAG_KEY=

# Порт (Railway задаёт свой через PORT автоматически).
PORT=3000

# Путь к файлу состояния мониторинга. На Railway смонтируйте Volume в /app/data.
DATA_PATH=data/monitor.json

# Таймаут Long Polling GET /updates в секундах (0–90).
POLL_TIMEOUT=30
